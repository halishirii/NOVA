<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NOVA | نووآ - سامانه هوشمند مدیریت ویزیت</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #f3f6fb;
            --bg-card: #ffffff;
            --bg-subtle: #f1f5f9;
            --text-primary: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --accent: #1d63ed;
            --accent-hover: #1550c7;
            --accent-soft: #e8f0fe;
            --accent-text: #1d63ed;
            --ring-color: #1d63ed;
        }

        [data-theme="dark"] {
            --bg-main: #0b1120;
            --bg-card: #131c31;
            --bg-subtle: #1e293b;
            --text-primary: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #26334d;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --accent-soft: rgba(59, 130, 246, 0.16);
            --accent-text: #93c5fd;
            --ring-color: #3b82f6;
        }

        [data-theme="blue"] {
            --bg-main: #0a192f;
            --bg-card: #112240;
            --bg-subtle: #1d3557;
            --text-primary: #e6f1ff;
            --text-muted: #8892b0;
            --border-color: #233554;
            --accent: #38bdf8;
            --accent-hover: #0284c7;
            --accent-soft: rgba(56, 189, 248, 0.16);
            --accent-text: #7dd3fc;
            --ring-color: #38bdf8;
        }

        [data-theme="pink"] {
            --bg-main: #fdf2f8;
            --bg-card: #ffffff;
            --bg-subtle: #fce7f3;
            --text-primary: #1f121b;
            --text-muted: #705265;
            --border-color: #fbcfe8;
            --accent: #db2777;
            --accent-hover: #be185d;
            --accent-soft: #fce7f3;
            --accent-text: #be185d;
            --ring-color: #db2777;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            margin: 0;
            padding: 0;
            transition: background-color 0.25s ease, color 0.25s ease;
            overflow-x: hidden;
        }

        .pv-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            box-shadow: 0 8px 24px -6px rgba(15, 23, 42, 0.06);
            transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.15s ease;
        }

        [data-theme="dark"] .pv-card,
        [data-theme="blue"] .pv-card {
            box-shadow: 0 10px 28px -8px rgba(0, 0, 0, 0.45);
        }

        .pv-subtle {
            background-color: var(--bg-subtle);
            border: 1px solid var(--border-color);
        }

        .pv-muted {
            color: var(--text-muted);
        }

        .pv-btn-primary {
            background-color: var(--accent);
            color: #ffffff;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        [data-theme="blue"] .pv-btn-primary {
            color: #081226;
        }

        .pv-btn-primary:hover {
            background-color: var(--accent-hover);
        }

        .pv-btn-primary:active {
            transform: scale(0.985);
        }

        .pv-icon-tile {
            background-color: var(--accent);
            color: #ffffff;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 14px -4px rgba(29, 99, 237, 0.35);
        }

        [data-theme="blue"] .pv-icon-tile {
            color: #081226;
        }

        .pv-soft-badge {
            background-color: var(--accent-soft);
            color: var(--accent-text);
        }

        .pv-input {
            background-color: var(--bg-card);
            color: var(--text-primary);
            border: 1.5px solid var(--border-color);
            border-radius: 14px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .pv-input:focus {
            outline: none;
            border-color: var(--ring-color);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }

        .nova-wordmark {
            font-weight: 900;
            letter-spacing: 0.08em;
            background: linear-gradient(135deg, #0f294a 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        [data-theme="dark"] .nova-wordmark,
        [data-theme="blue"] .nova-wordmark {
            background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="min-h-screen select-none">

    <!-- Toast Notification Banner -->
    <div id="toastBanner" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] transition-all duration-300 opacity-0 pointer-events-none w-[92%] max-w-sm">
        <div class="bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center justify-between gap-2 text-xs font-medium border border-slate-700">
            <div class="flex items-center gap-2">
                <span id="toastIcon" class="text-base">✨</span>
                <span id="toastText">پیام سیستم</span>
            </div>
            <button onclick="hideToast()" class="text-slate-400 hover:text-white text-sm px-1 cursor-pointer">✕</button>
        </div>
    </div>

    <!-- App Container (Mobile First) -->
    <div id="appShell" class="max-w-md mx-auto min-h-screen relative flex flex-col">

        <!-- ========================================================= -->
        <!-- 1. LOGIN SCREEN                                           -->
        <!-- ========================================================= -->
        <section id="loginScreen" class="min-h-screen flex flex-col justify-between p-4 relative">
            <div class="flex justify-between items-center pt-1">
                <div class="pv-card px-3 py-2 text-[11px] font-bold flex items-center gap-1.5">
                    <span id="cloudStatusDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                    <span id="cloudStatusLabel">در حال اتصال به nova-archive01...</span>
                </div>

                <button onclick="openThemeSheet()" title="انتخاب تم" aria-label="انتخاب تم"
                    class="w-12 h-12 pv-card rounded-2xl flex items-center justify-center shadow-sm cursor-pointer hover:scale-105 transition">
                    <svg class="w-6 h-6" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                </button>
            </div>

            <div class="pv-card p-6 my-auto space-y-5">
                <div class="flex flex-col items-center text-center space-y-1">
                    <div class="flex items-center justify-center gap-2" dir="ltr">
                        <svg class="w-9 h-9" viewBox="0 0 40 40" fill="none">
                            <rect width="40" height="40" rx="12" fill="var(--accent)" />
                            <path d="M11 28V12L21 28V12" stroke="#ffffff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M27 12L31 28L23 28L27 12Z" fill="#f59e0b" />
                        </svg>
                        <div class="flex flex-col items-center leading-none">
                            <span class="text-3xl nova-wordmark">NOVA</span>
                            <span class="text-[9px] font-extrabold tracking-[0.35em] pv-muted mt-0.5">ARCHIVE • نووآ</span>
                        </div>
                    </div>
                    <h1 class="text-base font-extrabold pt-2" style="color: var(--accent);">
                        نووآ؛ طراحی نو، تفکری برتر
                    </h1>
                </div>

                <form id="loginForm" onsubmit="handleLoginSubmit(event)" class="space-y-3.5">
                    <div>
                        <input type="text" id="loginUsername" required placeholder="نام کاربری"
                            class="w-full pv-input px-4 py-3.5 text-sm font-medium text-right" autocomplete="username">
                    </div>

                    <div class="relative">
                        <input type="password" id="loginPassword" required placeholder="رمز عبور"
                            class="w-full pv-input pl-11 pr-4 py-3.5 text-sm font-medium text-right" autocomplete="current-password">
                        <button type="button" onclick="togglePasswordVisibility()"
                            class="absolute left-3.5 top-1/2 -translate-y-1/2 pv-muted hover:opacity-80 cursor-pointer" title="نمایش/مخفی کردن رمز">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>

                    <div>
                        <input type="text" id="loginCaptchaInput" required placeholder="عبارت امنیتی را وارد کنید"
                            class="w-full pv-input px-4 py-3.5 text-sm font-medium text-right" maxlength="6">
                    </div>

                    <div class="flex items-center justify-center gap-3 pt-1" dir="ltr">
                        <button type="button" onclick="refreshCaptcha()" title="تغییر کد امنیتی"
                            class="w-11 h-11 pv-btn-primary rounded-xl flex items-center justify-center shadow-sm cursor-pointer">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                        </button>
                        <div class="pv-subtle px-6 py-2.5 rounded-xl flex items-center justify-center min-w-[144px]">
                            <span id="captchaDisplay" class="text-xl font-extrabold tracking-[0.28em] line-through decoration-2" style="color: var(--text-primary);">TSLU</span>
                        </div>
                    </div>

                    <button type="submit" class="w-full pv-btn-primary py-3.5 rounded-2xl font-bold text-sm shadow-md flex items-center justify-center gap-2 cursor-pointer mt-2">
                        <span>ورود</span>
                        <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                        </svg>
                    </button>
                </form>

                <div class="pt-3 border-t flex items-center justify-between text-[11px]" style="border-color: var(--border-color);">
                    <span class="pv-muted">پیش‌فرض مدیر: <b class="font-bold">admin</b> / <b class="font-bold">1234</b></span>
                    <button type="button" onclick="quickFillDemoUser()" class="px-3 py-1.5 rounded-xl font-bold pv-soft-badge cursor-pointer">
                        پر کردن سریع
                    </button>
                </div>
            </div>

            <div class="text-center text-[11px] pv-muted pb-2">
                متصل به فضای ابری Firebase • پروژه nova-archive01
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- 2. AUTHENTICATED MAIN APP SHELL                           -->
        <!-- ========================================================= -->
        <section id="mainAppScreen" class="hidden min-h-screen flex-col pb-28">

            <!-- Top Header -->
            <header class="px-4 pt-4 pb-3 flex items-center justify-between sticky top-0 z-30 backdrop-blur-md" style="background-color: color-mix(in srgb, var(--bg-main) 88%, transparent);">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full p-0.5 flex items-center justify-center font-extrabold text-base text-white shadow-sm shrink-0"
                        style="background: linear-gradient(135deg, var(--accent), #0ea5e9);" id="headerUserAvatar">
                        ح
                    </div>
                    <div class="text-right">
                        <div id="headerGreeting" class="text-xs font-medium flex items-center gap-1 pv-muted">
                            <span>شب بخیر</span>
                            <span>🌙</span>
                        </div>
                        <div id="headerUserName" class="text-sm font-extrabold">حسین علی‌شیری</div>
                        <div class="flex items-center gap-1.5 mt-0.5">
                            <span id="headerCloudBadge" class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full pv-soft-badge">
                                <span id="headerCloudDot" class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                <span id="headerCloudText">Online • nova-archive01</span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="syncWithFirestore(true)" title="همگام‌سازی با فایربیس" aria-label="همگام‌سازی"
                        class="w-11 h-11 pv-card rounded-2xl flex items-center justify-center cursor-pointer hover:opacity-85 transition">
                        <svg id="syncIconSvg" class="w-5 h-5" style="color: var(--accent);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    </button>

                    <button onclick="openThemeSheet()" title="انتخاب تم" aria-label="انتخاب تم"
                        class="w-11 h-11 pv-card rounded-2xl flex items-center justify-center cursor-pointer hover:opacity-85 transition">
                        <svg class="w-5 h-5" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                        </svg>
                    </button>

                    <button onclick="handleLogout()" title="خروج از حساب" aria-label="خروج از حساب"
                        class="w-11 h-11 pv-card rounded-2xl flex items-center justify-center cursor-pointer hover:opacity-85 transition">
                        <svg class="w-5 h-5" style="color: var(--text-primary);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                    </button>
                </div>
            </header>

            <!-- ========================================================= -->
            <!-- TAB 1: HOME DASHBOARD                                     -->
            <!-- ========================================================= -->
            <div id="tabHome" class="px-4 space-y-4">
                <div class="pv-card p-4 space-y-3.5">
                    <div class="flex items-center justify-between">
                        <h2 id="homeDateHeading" class="text-sm font-extrabold">برنامه امروز نووآ</h2>
                        <span id="homeProgressBadge" class="text-[11px] font-bold px-3 py-1 rounded-full pv-soft-badge">
                            ۰ از ۰ انجام شد
                        </span>
                    </div>

                    <div class="grid grid-cols-3 gap-2.5 text-center">
                        <div class="pv-subtle rounded-2xl py-3 px-2">
                            <div id="statTotalVisits" class="text-lg font-extrabold">۰</div>
                            <div class="text-[11px] pv-muted mt-0.5">ویزیت امروز</div>
                        </div>
                        <div class="pv-subtle rounded-2xl py-3 px-2">
                            <div id="statCompletedVisits" class="text-lg font-extrabold">۰</div>
                            <div class="text-[11px] pv-muted mt-0.5">انجام شده</div>
                        </div>
                        <div class="pv-subtle rounded-2xl py-3 px-2">
                            <div id="statPendingVisits" class="text-lg font-extrabold">۰</div>
                            <div class="text-[11px] pv-muted mt-0.5 leading-tight">در انتظار تکمیل</div>
                        </div>
                    </div>

                    <div class="w-full h-2 rounded-full overflow-hidden" style="background-color: var(--bg-subtle);">
                        <div id="homeProgressBar" class="h-full rounded-full transition-all duration-300" style="width: 0%; background-color: var(--accent);"></div>
                    </div>
                </div>

                <!-- Golden Bonus Card -->
                <div class="pv-card p-4">
                    <button onclick="toggleBonusAccordion()" class="w-full flex items-center justify-between text-right cursor-pointer">
                        <div class="flex items-center gap-3">
                            <div class="pv-icon-tile w-11 h-11 shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-sm font-extrabold">طرح پاداش طلایی نووآ</div>
                                <div id="bonusRemainingText" class="text-[11px] font-bold mt-0.5" style="color: var(--accent-text);">
                                    در حال محاسبه وضعیت ویزیت‌ها...
                                </div>
                            </div>
                        </div>
                        <svg id="bonusChevron"
